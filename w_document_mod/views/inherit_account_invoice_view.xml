<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="w_inherit_account_invoice_form_view">
            <field name="name">w.inherit.account.invoice.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='narration']" position="after">
                    <group>
                        <field name="observations"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_move_form_inherit_edit_invoice_user" model="ir.ui.view">
            <field name="name">account.move.form.edit.invoice.user</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                    <attribute name="groups">account.group_account_manager</attribute>
                    <attribute name="readonly">0</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>