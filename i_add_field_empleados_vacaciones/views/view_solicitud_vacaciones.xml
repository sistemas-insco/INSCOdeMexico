<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--search view de vacaiones-->
    <record id="i_add_fields_empleados_view_search_vacaciones" model="ir.ui.view">
        <field name="name">i.add.fields.empleados.view.search.vacaciones</field>
        <field name="model">solicitud.vacaciones</field>
        <field name="arch" type="xml">
            <search string="Search Vacaciones">
                <field name="user_id"/>
                <field name="empleado_id"/>
                <field name="departamento_id"/>
                <field name="solicitud_tipo"/>
                <separator />
            </search>
        </field>
    </record>




     <!--kanban view de vacaciones-->
        <record id="i_add_fields_empleados_view_kanban_vacaciones" model="ir.ui.view">
            <field name="name">i.add.fields.empleados.view.kanban.vacaciones</field>
            <field name="model">solicitud.vacaciones</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile o_kanban_view" default_group_by="solicitud_tipo">
                    <field name="empleado_id" readonly="1"/>
                    <field name="departamento_id"/>
                    <field name="state" readonly="1"/>
                    <field name="solicitud_tipo" readonly="1"/>
                    <field name="name"/>

                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_record oe_kanban_global_click">
                                <!-- Encabezado del registro -->
                                <div class="o_kanban_header">
                                    <div class="o_kanban_title">
                                        <strong>
                                            <t t-esc="record.name.value or 'Sin número'"/>
                                        </strong>
                                    </div>
                                    <!-- Badge para estado -->
                                    <div class="o_kanban_status badge bg-info text-white text-capitalize">
                                        <t t-esc="record.state.value or 'N/A'"/>
                                    </div>
                                </div>

                                <!-- Detalles del registro -->
                                <div class="o_kanban_details mt-2">
                                    <div class="o_kanban_primary_bottom">
                                        <div class="o_kanban_secondary_info">
                                            <p><b>Empleado:</b> <t t-esc="record.empleado_id.value or '-'"/></p>
                                            <p><b>Departamento:</b> <t t-esc="record.departamento_id.value or '-'"/></p>
                                            <p><b>Tipo de Solicitud:</b> <t t-esc="record.solicitud_tipo.value or '-'"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!--tree view de vaciones-->
        <record model="ir.ui.view" id="i_add_fields_empleados_view_tree_vacaciones">
            <field name="name">i.add.fields.empleados.view.tree.vacaciones</field>
            <field name="model">solicitud.vacaciones</field>
            <field name="arch" type="xml">
                <list string="Tree Vacaciones">
                <field name="empleado_id" />
                <field name="departamento_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                 <field name="solicitud_tipo"/>
                 <field name="numero_dias_solicitaso" sum = " TotalP "/>
                <field name="state"/>
                </list>  
            </field>
        </record>

        <!--form view de vacaciones-->
        <record id="i_add_fields_empleados_view_form_vacaciones" model="ir.ui.view">
            <field name="name">i.add.fields.empleados.view.form.vacacioneso</field>
            <field name="model">solicitud.vacaciones</field>
            <field name="arch" type="xml">
                <form string="Form View Vacaciones">
                     <field name="active" invisible="1"/>

                    <header>
                <button name="action_solicitud_send" string="Enviar solicitud" type="object"/>
                <button name="solictud_aprovada" string="Aprobado"  type="object" class="btn-primary"  groups="i_add_field_empleados_vacaciones.group_vacaiones_manager" invisible="state in ['aprobado', 'cancelado']"/>
                <button name="solictud_cancelada" string="Cancelar"  type="object"  groups="i_add_field_empleados_vacaciones.group_vacaiones_manager" class="btn-primary" invisible="state in ['aprobado', 'cancelado']"/>

                        <field name="state"
                                widget="statusbar"
                                status_visible="nuevo,por aprobar,aprobado,cancelado"/>
                    </header>

                <sheet>
                     
            <div class="oe_title">  
                <h1>Solicitud de Vacaciones o Permisos</h1>
                <h3><field name="name" /></h3>  
            </div>
            <group col="2"> 

                <group string="Datos del empleado ">
                 <field name="user_id"/>
                <field name="empleado_id" readonly="state in ['aprobado', 'cancelado']"/>
                <field name="departamento_id"/>
                 <field name="usuario_responsable"/>
                <field name="dias_vacaciones"/>
                </group>


                <group string="Datos de la solicitud ">
                <field name="solicitud_tipo" readonly="state in ['aprobado', 'cancelado']"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="numero_dias_solicitaso" readonly="state in ['aprobado', 'cancelado']"/>
                </group>

                <group>
                <field name="descripcion_solicitud"/>
                </group>

            </group>
                 </sheet>
                 <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="action_menu_vacaciones" model="ir.actions.act_window">
            <field name="name">Permisos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solicitud.vacaciones</field>
            <field name="view_mode">list,form,kanban</field>
           
        </record>

        <menuitem
            action="action_menu_vacaciones"
            id="action_menu_vacaciones_toket"
            parent="hr.menu_hr_root"
            name="Permisos y Vacaciones"
            sequence="103"/>

    </data>
</odoo>